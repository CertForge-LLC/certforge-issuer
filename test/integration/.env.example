# Copy to .env and fill in your values before running make test-integration
# The .env file is gitignored — never commit real tokens.

# CertForge API base URL
CERTFORGE_URL=https://dev.certgovernance.app

# API token — must have enroll + read + approve scopes
CERTFORGE_TOKEN=cc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DTP with auto_approve:true — used for Tests 1, 2, 3
AUTO_APPROVE_DTP=faltys-approval-policy

# DTP with auto_approve:false — used for Test 4 (rejection)
MANUAL_APPROVE_DTP=payment-soc2

# Domain covered by AUTO_APPROVE_DTP (without subdomain prefix)
TEST_DOMAIN_AUTO=faltys.com

# Domain covered by MANUAL_APPROVE_DTP (without subdomain prefix)
TEST_DOMAIN_MANUAL=payment.thepatrion.com

# Optional overrides
# KIND_CLUSTER_NAME=certforge-test
# CERTFORGE_ISSUER_NS=certforge-system
# TIMEOUT_AUTO=120
# TIMEOUT_MANUAL=300
# TIMEOUT_RENEWAL=120
# KEEP_CLUSTER=1       # set to 1 to leave the cluster after tests
# SKIP_BUILD=1         # set to 1 to skip docker build (reuse existing image)
